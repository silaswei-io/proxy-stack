#!/bin/sh
set -eu
cd -- "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
command -v docker >/dev/null 2>&1 || { echo "Docker is required" >&2; exit 1; }
if [ -f .proxy-stack-managed ]; then
  # Managed installs take their identity/settings from their own .env, not an
  # unrelated project's exported shell variables. Advanced source use is unchanged.
  unset COMPOSE_FILE COMPOSE_PROJECT_NAME COMPOSE_PROFILES COMPOSE_PATH_SEPARATOR
  unset COMPOSE_ENV_FILES COMPOSE_DISABLE_ENV_FILE
  unset DOMAIN NODE_NAME HOST_NODE_NAME MODE PUBLIC_PORT HTTP_PORT HTTP_BIND HTTP01_ONLY CONTACT_EMAIL UPDATE_INTERVAL
  unset TOOL_IMAGE CADDY_IMAGE ROLE LOCAL_NODE LEASE_SECONDS
fi
cmd=${1:-help}
if [ "$#" -eq 0 ] && [ -t 0 ]; then cmd=menu; fi
if [ "$#" -gt 0 ]; then shift; fi
case "$cmd" in
  menu)
    [ "$#" -eq 0 ] || { echo "menu takes no options" >&2; exit 2; }
    # Read the terminal, never the piped installer or a Docker command's stdin.
    if ! ( : <>/dev/tty ) 2>/dev/null; then
      echo "菜单需要交互终端；无终端请使用 links、status 或 user 命令。" >&2
      exit 2
    fi
    exec 3<>/dev/tty
    while :; do
      printf '\n代理管理\n订阅与朋友\n  1) 我的订阅 / QX 链接\n  2) 添加朋友并显示订阅\n  3) 撤销朋友\n服务与完成检查\n  4) 重试完成检查\n  5) 服务和规则状态\n  6) 刷新规则\n  7) 更新 v1.0.0 镜像\n节点管理\n  8) 节点同步状态\n  9) 生成限时加入码\n  10) 移除节点\n  11) 加入已有中心\n  0) 退出\n选择: ' >&3
      IFS= read -r choice <&3 || break
      case "$choice" in
        1) "$0" links --labelled || : ;;
        2|3)
          printf '朋友标识（英文/拼音，小写字母开头，最多32位，可含数字、_、-）: ' >&3
          IFS= read -r friend <&3 || break
          if [ "$choice" = 2 ]; then
            if "$0" user add "$friend"; then "$0" links --user "$friend" --labelled || :; fi
          else
            printf '撤销将下发所有节点，离线节点租约到期停止。确认撤销 %s？[y/N]: ' "$friend" >&3
            IFS= read -r answer <&3 || break
            case "$answer" in y|Y) "$0" user revoke "$friend" || : ;; esac
          fi
          ;;
        4) "$0" finish || : ;;
        5) "$0" status || : ;;
        6) "$0" update-rules || : ;;
        7)
          printf '拉取 v1.0.0 并更新正在运行的服务；保留 .env、模板和凭据。确认？[y/N]: ' >&3
          IFS= read -r answer <&3 || break
          case "$answer" in y|Y) "$0" upgrade || : ;; esac
          ;;
        8) "$0" node list || : ;;
        9) "$0" node code || : ;;
        10)
          printf '要移除的节点 ID（从节点状态复制；本机为 local）: ' >&3
          IFS= read -r node_id <&3 || break
          "$0" node remove "$node_id" || :
          ;;
        11) "$0" node join <&3 || : ;;
        0) break ;;
        *) printf '请选择 0–11。\n' >&3 ;;
      esac
    done
    ;;
  upgrade)
    [ "$#" -eq 0 ] || { echo "upgrade takes no options" >&2; exit 2; }
    [ -f .proxy-stack-managed ] && [ ! -L .proxy-stack-managed ] &&
      [ "$(cat .proxy-stack-managed)" = proxy-stack-installer-v1 ] || {
      echo "upgrade 仅支持安装器创建的受管 v1.0.0 目录；源码/未受管安装需自行管理镜像。" >&2
      exit 2
    }
    for file in .env compose.yaml compose.external.yaml proxyctl; do
      [ -f "$file" ] && [ ! -L "$file" ] || { echo "unsafe managed file: $file" >&2; exit 2; }
    done
    tool_image=ghcr.io/silaswei/proxy-stack:v1.0.0
    image=$(docker compose config --images manager)
    [ "$image" = "$tool_image" ] || {
      echo "upgrade 仅支持 ghcr.io/silaswei/proxy-stack:v1.0.0；自定义镜像请手动迁移。" >&2
      exit 2
    }
    running=$(docker compose ps --services --status running)
    docker pull "$tool_image"
    if [ -n "$running" ]; then
      # Compose service names are validated identifiers returned by Compose.
      docker compose up -d --no-deps --no-build --pull never --force-recreate $running
    fi
    echo "v1.0.0 镜像已更新；.env、模板和身份保留。请检查 node list 和服务状态。"
    ;;
  node)
    if [ "${1:-}" = join ]; then
      shift
      [ "$#" -eq 0 ] || { echo "node join reads its code from stdin" >&2; exit 2; }
      "$0" join
    else
      docker compose run --rm -T --interactive=false --no-deps manager node "$@"
    fi
    ;;
  finish)
    # Keep Compose lifecycle noise out of the completion result. Never log stdout:
    # a successful finish intentionally discloses the owner's private link there.
    finish_log=$(mktemp "${TMPDIR:-/tmp}/proxy-stack-finish.XXXXXXXX")
    chmod 600 "$finish_log"
    if docker compose --progress quiet run --rm -T --interactive=false --no-deps manager finish --command "$PWD/proxyctl" "$@" 2>"$finish_log"; then
      rm -f "$finish_log"
    else
      result=$?
      if [ -s "$finish_log" ]; then
        printf '诊断日志：%s\n' "$finish_log" >&2
      else
        rm -f "$finish_log"
      fi
      exit "$result"
    fi
    ;;
  init|links|verify|update-rules|detach)
    docker compose run --rm -T --interactive=false --no-deps manager "$cmd" "$@"
    ;;
  status)
    docker compose run --rm -T --interactive=false --no-deps manager status "$@"
    docker compose run --rm -T --interactive=false --no-deps manager node list || :
    docker compose ps
    ;;
  join)
    # Join secret travels on stdin only, never in argv/environment/Compose logs.
    if [ -t 0 ]; then
      printf '粘贴限时加入码（输入隐藏）: ' >&2
      trap 'stty echo' EXIT HUP INT TERM
      stty -echo
      IFS= read -r code
      stty echo
      trap - EXIT HUP INT TERM
      printf '\n' >&2
      printf '%s\n' "$code" | docker compose run --rm -T --no-deps manager join
    else
      docker compose run --rm -T --no-deps manager join
    fi
    ;;
  user)
    docker compose run --rm -T --interactive=false --no-deps manager user "$@"
    ;;
  up)
    docker compose run --rm -T --interactive=false --no-deps manager health >/dev/null
    docker compose up -d "$@"
    ;;
  down)
    [ "$#" -eq 0 ] || { echo "down takes no options; data and certificates are retained" >&2; exit 2; }
    docker compose down
    ;;
  *)
    echo "Usage: ./proxyctl {menu|init|finish [--wait 0..120]|links [--user NAME] [--labelled]|status|verify|update-rules|upgrade|user add/revoke NAME|node code/list/remove ID|join|detach|up|down}"
    exit 2
    ;;
esac
