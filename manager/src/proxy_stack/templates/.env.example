# Non-secret inputs. Set DOMAIN to an ASCII/punycode domain or global public IP (raw IPv6).
# The installer detects an omitted address; advanced source Compose requires DOMAIN.
# NODE_NAME may be blank: HOST_NODE_NAME, if exported by the host, then address fallback.
DOMAIN=proxy.example.com
NODE_NAME=
MODE=standalone
PUBLIC_PORT=443
HTTP_PORT=80
CONTACT_EMAIL=
UPDATE_INTERVAL=86400
# For a local build, set TOOL_IMAGE=proxy-stack-tool:0.1.2 instead.
TOOL_IMAGE=ghcr.io/silaswei/proxy-stack:0.1.2
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.7.11@sha256:a1644183accdb0b5be967093fe34be756fd5de15fe2ee0206e842ae17350967f
CADDY_IMAGE=caddy:2.11.4@sha256:0c994536bddb66445885237f1a5dcc1916bccea922661c76b4e9fc24061f9b52
# Existing host Caddy mode: set MODE=existing-caddy AND uncomment next line.
# COMPOSE_FILE=compose.yaml:compose.external.yaml
